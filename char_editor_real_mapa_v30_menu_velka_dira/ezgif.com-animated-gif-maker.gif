<!DOCTYPE html><html lang="cs"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Vyčistit cache</title><style>html,body{margin:0;height:100%;background:#050506;color:#ddd;font-family:monospace;display:grid;place-items:center;text-align:center}.box{border:1px solid #900;padding:24px;background:#080808}</style></head><body><div class="box"><h2>Čistím cache...</h2><p id="s">čekej</p></div><script>(async()=>{try{if('serviceWorker'in navigator){const regs=await navigator.serviceWorker.getRegistrations();await Promise.all(regs.map(r=>r.unregister()))}if(window.caches){const keys=await caches.keys();await Promise.all(keys.map(k=>caches.delete(k)))}document.getElementById('s').textContent='Hotovo. Spouštím loading...'}catch(e){document.getElementById('s').textContent='Spouštím loading...'}setTimeout(()=>location.replace('./loading.html?v=88'),450)})();</script></body></html>